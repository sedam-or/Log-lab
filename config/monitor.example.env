# Contract 1.0.0; monitor; generated, no real secrets.
# Copy to the private env path, fill placeholders, then validate.
# Literal KEY=value. Do not execute this file with shell source.
LOGLAB_CONTRACT_VERSION=1.0.0
LOGLAB_PORT=8443
LOGLAB_SOURCE_ID=login-lab-a
LOGLAB_CA_BUNDLE=/etc/loglab/ca.crt
LOGLAB_TLS_CERT=/etc/loglab/tls.crt
LOGLAB_TLS_KEY=/etc/loglab/tls.key
LOGLAB_ROLE=monitor
LOGLAB_BIND_HOST=172.16.202.22
LOGLAB_DB_PATH=/var/lib/loglab/monitor.sqlite3
LOGLAB_MODEL_PATH=/var/lib/loglab/model.json
LOGLAB_OPERATOR_USERNAME=operator
LOGLAB_SOURCE_TOKEN=__SET_ONCE_PER_LAB__
LOGLAB_OPERATOR_PASSWORD_HASH=__HASH_OPERATOR_PASSWORD__
